# Пример окружения сервера. Скопируйте в .env и заполните.
# Файл .env в git не попадает (.gitignore), этот — попадает.

# Порт HTTP API
PORT=8080

# Строка подключения к Postgres
DATABASE_URL=postgres://anti:anti@localhost:5432/antipulse?sslmode=disable

# Токен бота MAX. Нужен боту (long polling) и для проверки подписи
# initData мини-аппа. Без него бот выключен, auth только dev-режим.
MAX_BOT_TOKEN=

# true — каждый API-запрос обязан нести валидную подпись в заголовке
# X-Max-Init-Data, иначе 401. Требует MAX_BOT_TOKEN. Для прода.
MAX_REQUIRE_INIT_DATA=false

# Allowlist origin'ов для MINI App через запятую.
# Пусто — заголовки CORS не ставятся (dev ходит через Vite-proxy).
# Пример: CORS_ORIGINS=https://myapp.example.com
CORS_ORIGINS=

# Имя мини-аппа, привязанного к боту: кнопка «▶️ Начать анализ» (open_app).
# Если задан MAX_MINI_APP_URL — приоритет у ссылки-фолбэка.
MAX_MINI_APP_NAME=

# Deeplink мини-аппа — fallback-кнопка, если имя апа неизвестно.
# Пример: MAX_MINI_APP_URL=https://max.ru/<bot>?startapp=<app>
MAX_MINI_APP_URL=

# Каталог собранного Mini App (frontend/dist), из него Go раздаёт статику.
# Пусто — статика не раздаётся, только API.
FRONTEND_DIST=

# Для интеграционных тестов репозитория (необязательно):
# TEST_DATABASE_URL=postgres://anti:anti@localhost:5432/antipulse?sslmode=disable
